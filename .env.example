# ── App ─────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=store_intelligence

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=store-intelligence-group

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-this-in-production-purplle-2026

# ── CV Pipeline ──────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# ── Store Config ─────────────────────────────────────────────
OCCUPANCY_MAX_STORE_1=80
OCCUPANCY_MAX_STORE_2=50
QUEUE_THRESHOLD=5
LOW_CONVERSION_THRESHOLD=0.2
